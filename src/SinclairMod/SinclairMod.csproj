<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SinclairMod</RootNamespace>
    <AssemblyName>SinclairMod</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <RiskOfRain2Path Condition="'$(RiskOfRain2Path)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Risk of Rain 2</RiskOfRain2Path>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="RoR2">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/RoR2.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.AnimationModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RiskOfRain2Path)/Risk of Rain 2_Data/Managed/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExPath)/core/BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="MMHOOK_Assembly-CSharp">
      <HintPath>$(BepInExPath)/plugins/MMHOOK_Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="R2API">
      <HintPath>$(BepInExPath)/plugins/R2API.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
